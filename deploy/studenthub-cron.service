[Unit]
Description=Student Hub daily jobs: deadline reminders first, then feature jobs (mentors, market, events, ambassador, b2b)

[Service]
Type=oneshot
EnvironmentFile=/opt/studenthub/.env
ExecStart=/bin/sh -c 'curl -fsS -m 120 -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:8110/api/cron'
# '-': these answer 404 while their feature switch is off
ExecStart=-/bin/sh -c 'curl -fsS -m 120 -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:8110/api/cron/mentors'
ExecStart=-/bin/sh -c 'curl -fsS -m 300 -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:8110/api/cron/market'
ExecStart=-/bin/sh -c 'curl -fsS -m 120 -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:8110/api/cron/events'
ExecStart=-/bin/sh -c 'curl -fsS -m 120 -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:8110/api/cron/ambassador'
ExecStart=-/bin/sh -c 'curl -fsS -m 120 -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:8110/api/cron/b2b'
