[Unit]
Description=Student Hub API (Go): JSON API, Telegram webhook, daily reminders
After=network-online.target docker.service
Wants=network-online.target

[Service]
Environment=UPLOAD_DIR=/opt/studenthub/uploads
EnvironmentFile=/opt/studenthub/.env
WorkingDirectory=/opt/studenthub
ExecStart=/opt/studenthub/studenthub-api
Restart=always
RestartSec=3
User=studenthub
MemoryMax=150M
NoNewPrivileges=true
ProtectSystem=strict
# market photos (prompt 08) are the only files the API writes
ReadWritePaths=-/opt/studenthub/uploads
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
