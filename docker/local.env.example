# docker/local.env — optional settings for docker/docker-compose.local.yml (copy, never commit the copy).
# Everything is optional: without these the site, the feed (backend/data/*.json) and guest features work.
# BOT_TOKEN=
# BOT_USERNAME=
# ADMIN_TELEGRAM_IDS=
# OPENAI_API_KEY=
# FEATURE_QUIZ=true
# FEATURE_EVENTS=true
# Web Push (docs/PUSH.md): keys from `cd backend && go run ./cmd/vapid-keys`
# FEATURE_WEBPUSH=true
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
