# docker/local.env — optional settings for docker/docker-compose.local.yml (copy, never commit the copy).
# Everything is optional: without these the site, the feed (backend/data/*.json) and guest features work.
# BOT_TOKEN=
# BOT_USERNAME=
# ADMIN_TELEGRAM_IDS=
# OPENAI_API_KEY=
# FEATURE_QUIZ=true
# FEATURE_EVENTS=true
# Café pre-ordering (docs/cafe.md); the demo café needs: CAFE_DEMO_SEED=dev go run ./cmd/cafe-seed
# FEATURE_CAFE=true
# CAFE_SHOW_DEMO=true
# With --profile cafe-kaspi (values must match docker/kaspi-pos.env):
# CAFE_KASPI_URL=http://kaspi-pos:3000
# CAFE_KASPI_API_KEY=
# CAFE_KASPI_SESSION_KEY=
# CAFE_KASPI_WEBHOOK_SECRET=
# FEATURE_FEEDS=true                       # opportunity feed (docs/feeds.md); collector: go run ./cmd/feeds-collect
# FEEDS_AI_DAILY_LIMIT=150000
# FEEDS_AUTOPUBLISH_MIN_CONFIDENCE=0.85
# FEATURE_STREAK=true
# FEATURE_FAIRS=true
