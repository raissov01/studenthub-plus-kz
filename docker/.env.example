# /opt/studenthub/docker/.env on the VPS — compose variables for docker/docker-compose.yml.
# docker/vps-apply.sh writes and updates this file; shown here only for reference. Never commit the real one.
API_TAG=0123456789ab
WEB_TAG=0123456789ab
POSTGRES_PASSWORD=<the password inside DATABASE_URL of /opt/studenthub/.env>
STUDENTHUB_UID=<id -u studenthub>
STUDENTHUB_GID=<id -g studenthub>
# STUDENTHUB_ENV_FILE=/opt/studenthub/.env
# STUDENTHUB_UPLOADS=/opt/studenthub/uploads
