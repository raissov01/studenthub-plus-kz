# /opt/studenthub/docker/.env on the VPS — compose variables for docker/docker-compose.yml.
# docker/vps-apply.sh writes and updates this file; shown here only for reference. Never commit the real one.
API_TAG=0123456789ab
WEB_TAG=0123456789ab
POSTGRES_PASSWORD=<the password inside DATABASE_URL of /opt/studenthub/.env>
STUDENTHUB_UID=<id -u studenthub>
STUDENTHUB_GID=<id -g studenthub>
# STUDENTHUB_ENV_FILE=/opt/studenthub/.env
# STUDENTHUB_UPLOADS=/opt/studenthub/uploads
# Café Kaspi sidecar (docs/cafe.md): written by vps-apply.sh / set by the operator
# KASPI_TAG=0123456789ab
# COMPOSE_PROFILES=cafe-kaspi        # starts the kaspi-pos sidecar; leave unset while cafés take only pay-at-pickup
# KASPI_POS_ENV_FILE=/opt/studenthub/kaspi-pos.env

# ---------------------------------------------------------------------------------------------------------
# Café pre-ordering pilot (docs/cafe.md), for reference only — these lines belong in OTHER files on the server,
# never commit real values. Generate keys with:  openssl rand -hex 32

# ===== /opt/studenthub/.env (api) =====
# FEATURE_CAFE=false
# Kaspi Pay through the café's own merchant account (needs the sidecar):
# CAFE_KASPI_URL=http://kaspi-pos:3000
# CAFE_KASPI_API_KEY=                # = INTERNAL_API_KEY in kaspi-pos.env (32+ chars)
# CAFE_KASPI_SESSION_KEY=            # 64 hex chars: encrypts the cafés' cashier sessions in Postgres
# CAFE_KASPI_WEBHOOK_SECRET=         # = WEBHOOK_SECRET in kaspi-pos.env
# CAFE_KASPI_TIMEOUT_MS=10000
# Limits (defaults shown):
# CAFE_MAX_ACTIVE_ORDERS=2           # not yet picked up, per student
# CAFE_DAILY_ORDERS=6                # per student and Almaty day
# CAFE_ORDERS_PER_HOUR=10            # create attempts per student
# CAFE_MAX_ORDER_TOTAL=3000000       # tiyn (30 000 ₸)
# CAFE_NO_SHOW_LIMIT=2               # no-shows within CAFE_NO_SHOW_DAYS → pay ahead with Kaspi only
# CAFE_NO_SHOW_DAYS=60
# CAFE_NO_SHOW_GRACE_MIN=10          # staff may mark no-show this long after the pickup time
# CAFE_PAY_TIMEOUT_MIN=10            # a pending Kaspi QR becomes failed
# CAFE_UNPAID_CANCEL_MIN=30          # an unpaid Kaspi order is cancelled
# CAFE_POLL_SECONDS=15               # payment poller interval
# CAFE_SHOW_DEMO=false               # never true in production
# Print shop (docs/print.md), the same sidecar and CAFE_KASPI_* keys:
# FEATURE_PRINT=false
# PRINT_MAX_ACTIVE_JOBS=3            # not yet picked up, per student
# PRINT_DAILY_JOBS=10                # per student and Almaty day
# PRINT_JOBS_PER_HOUR=20             # create attempts per student
# PRINT_UPLOADS_PER_HOUR=40          # upload attempts per student
# PRINT_DAILY_FILES=30               # files per student per 24 h
# PRINT_DAILY_MB=200                 # megabytes per student per 24 h
# PRINT_MAX_ORDER_TOTAL=3000000      # tiyn (30 000 ₸); keep ≤ the sidecar's MAX_PAYMENT_AMOUNT
# PRINT_PAY_TIMEOUT_MIN=10
# PRINT_UNPAID_CANCEL_MIN=60         # an unpaid Kaspi job with an agreed price leaves the queue
# PRINT_NO_SHOW_GRACE_MIN=120        # staff may mark no-show this long after ready / the pickup time
# PRINT_POLL_SECONDS=15

# ===== /opt/studenthub/kaspi-pos.env (sidecar) =====
# INTERNAL_API_KEY=                  # = CAFE_KASPI_API_KEY
# TOKEN_SECRET_KEY=                  # 64 hex chars: the sidecar encrypts vtokenSecret with it
# WEBHOOK_SECRET=                    # = CAFE_KASPI_WEBHOOK_SECRET
# MAX_PAYMENT_AMOUNT=30000           # ₸
# MAX_REFUND_AMOUNT=30000
# When Kaspi raises its minimum app version (login fails with OldVersionToUpdate):
# APP_VERSION=
# APP_BUILD=
