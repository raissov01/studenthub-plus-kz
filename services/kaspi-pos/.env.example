# ─── Required ───
# AES-256-GCM key that encrypts vtokenSecret before it leaves this service (64 hex chars).
#   openssl rand -hex 32
TOKEN_SECRET_KEY=
# Shared secret the main app sends as X-Internal-Api-Key on every /api/* call (min 32 chars).
# The server refuses to start without it.
#   openssl rand -hex 32
INTERNAL_API_KEY=

# ─── Network ───
PORT=3000
# 127.0.0.1 by default. In docker it is 0.0.0.0, but the port is never published to the host.
# HOST=127.0.0.1

# ─── Limits (KZT) ───
# Larger qr/invoice/refund amounts are rejected with 400.
MAX_PAYMENT_AMOUNT=100000
MAX_REFUND_AMOUNT=100000

# ─── Webhooks ───
# webhooks.json lives in DATA_DIR. Every hook needs a non-empty secret and an https URL.
# Plain http is allowed only for localhost and the hosts listed here (docker-internal names).
WEBHOOK_ALLOWED_HTTP_HOSTS=api
# Directory for keypair.json, device.json, tracked-payments.json, webhooks.json, logs/ (0700/0600).
# DATA_DIR=/data

# ─── Demo UI ───
# public/ test page. Keep false in production.
ENABLE_DEMO_UI=false

# ─── App version & device constants (optional) ───
# Kaspi raises its minimum app version periodically; when it does, login fails at the phone step with
# "OldVersionToUpdate" for every cashier. Set these to the current Kaspi Pay iOS release + build and restart.
# APP_VERSION=26.0921
# APP_BUILD=1115
# APP_PLATFORM=iOS
# APP_PLATFORM_VER=18.4
# APP_LOCALE=ru-RU
# APP_MODEL=iPhone17,3
