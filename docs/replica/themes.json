{
  "_about": "Student super-app themes (EN/RU/KK/DE) for Student Hub research.",
  "request_patterns": [
    "\\bi wish\\b", "\\bplease add\\b", "\\bwould be (nice|great|good|helpful)\\b", "\\bwould love\\b", "\\bno way to\\b",
    "\\b(missing|lacks|lacking)\\b", "\\bdoesn'?t (have|support|let|allow)\\b", "\\bwhy (can'?t|isn'?t|doesn'?t)\\b", "\\bneeds? (a|an|the|to|more)\\b",
    "добавьте", "сделайте", "верните", "хотелось бы", "нужно добавить", "почему нельзя", "почему нет", "нет возможности", "не хватает",
    "қосыңыз", "жасаңыз", "bitte", "wäre (schön|toll|gut|super|cool)", "\\bfehlt\\b", "wünsche"
  ],
  "themes": [
    {"id": "login", "label": "Logged out, re-login every time, password problems", "kind": "complaint",
     "patterns": ["log ?(me )?out", "logged out", "sign(ed)? ?out", "log ?in (again|every)", "keeps? (asking|logging)", "password", "логин", "пароль", "авториз", "выкидыва", "вылета\\w* (с|из) акк", "слета\\w* авториз", "заново (вводить|входить|заходить|логин)", "каждый раз .{0,30}(вход|логин|пароль)", "ausgeloggt", "passwort", "anmeld", "einlogg"]},
    {"id": "bugs", "label": "Crashes, errors, things that do not open", "kind": "complaint",
     "patterns": ["\\bcrash", "\\bbugs?\\b", "buggy", "glitch", "\\bbroken\\b", "(doesn'?t|does not|stopped) work", "not working", "\\berror\\b", "вылета", "не работает", "не открыва", "глюч", "баг", "ошибк", "белый экран", "сбо[ий]", "absturz", "stürzt", "funktioniert nicht", "fehler"]},
    {"id": "performance", "label": "Slow, endless loading, servers down", "kind": "complaint",
     "patterns": ["\\bslow\\b", "\\blag", "loading", "takes forever", "грузит", "загруз", "медлен", "тормоз", "лага", "тупит", "висн", "завис", "сервер", "langsam", "lädt"]},
    {"id": "bloat", "label": "Bloat: social feed, chats, music and extras nobody asked for", "kind": "complaint",
     "patterns": ["музык", "мессенджер", "лент[аеуы]", "соц ?сет", "ненужн", "бесполезн\\w* (функц|вклад|сервис)", "куча .{0,20}(функц|вклад|лишн)", "aitu", "кошел[её]к", "сериал", "развлечен", "bloat", "unnecessary", "social media", "too many features", "überladen"]},
    {"id": "ads", "label": "Ads inside a study app", "kind": "complaint",
     "patterns": ["реклам", "\\bads?\\b", "advert", "werbung", "sponsored"]},
    {"id": "attendance", "label": "QR attendance does not register", "kind": "complaint",
     "patterns": ["\\bqr\\b", "кьюар", "кюар", "кью ар", "посещ", "н/б", "пропуск", "attendance", "check.?in", "отмет"]},
    {"id": "core", "label": "Cannot see schedule, grades or tasks (the basics)", "kind": "complaint",
     "patterns": ["расписан", "оценк", "журнал", "балл", "задани", "умкд", "schedule", "timetable", "grades?\\b", "stundenplan", "noten\\b", "kurse"]},
    {"id": "web_parity", "label": "App does less than the website / desktop", "kind": "complaint",
     "patterns": ["на сайте", "через сайт", "через браузер", "сайт\\w* (лучше|удобнее)", "версии для пк", "на пк", "функционал\\w* сайта", "website", "web version", "desktop", "webversion"]},
    {"id": "ux", "label": "Confusing, cluttered, back button closes the app", "kind": "complaint",
     "patterns": ["confus", "hard to (use|find|navigate)", "complicated", "clutter", "unintuitive", "неудоб", "непонятн", "интуитивно", "назад", "свайп", "интерфейс", "unübersichtlich", "kompliziert"]},
    {"id": "updates", "label": "A redesign/update made it worse", "kind": "complaint",
     "patterns": ["after (the|this|latest|new) update", "since the update", "new update", "после обнов", "обнов\\w* (стал|всё|все|испорт)", "верните (как|стар|прежн)", "старую версию", "раньше было", "seit dem update", "nach dem update"]},
    {"id": "support", "label": "Support does not answer", "kind": "complaint",
     "patterns": ["support", "customer service", "поддержк", "no response from", "нет ответа"]},
    {"id": "jobs_quality", "label": "Jobs: spam, scams, ghosting, irrelevant listings", "kind": "complaint",
     "patterns": ["\\bscam", "fake (job|post|recruit)", "spam", "ghost", "never (hear|heard) back", "no response", "irrelevant", "not entry.level", "years of experience", "recruiters?\\b", "mlm", "unpaid"]},
    {"id": "discount_verify", "label": "Student verification and codes that do not work", "kind": "complaint",
     "patterns": ["verif", "student status", "\\bcode(s)? (doesn'?t|don'?t|didn'?t|not|never|won'?t)", "(doesn'?t|didn'?t|won'?t) (accept|apply)", "expired", "invalid", "not valid", "\\bid\\b.{0,20}(reject|upload)"]},
    {"id": "notifications", "label": "Notifications: too many, missing, cannot clear", "kind": "complaint",
     "patterns": ["notification", "push", "уведомл", "benachrichtig"]},
    {"id": "offline", "label": "Needs internet / campus Wi-Fi is bad", "kind": "complaint",
     "patterns": ["offline", "no (internet|connection|signal)", "без интернет", "интернет", "wifi", "wi-fi", "сеть", "kein internet"]},
    {"id": "biometric", "label": "Wants quick login: PIN, Face ID, fingerprint, saved password", "kind": "request",
     "patterns": ["face ?id", "touch ?id", "biometr", "биометр", "пин.?код", "pin", "отпечат", "автозаполн", "autofill", "save (my )?(password|login)", "сохран\\w* (логин|пароль|данные)"]},
    {"id": "dark", "label": "Dark mode", "kind": "request",
     "patterns": ["dark mode", "тёмн\\w* (тем|режим)", "темн\\w* (тем|режим)", "dark ?theme", "dunkelmodus", "dark-mode"]},
    {"id": "calendar", "label": "Calendar / schedule sync and widgets", "kind": "request",
     "patterns": ["calendar", "widget", "календар", "виджет", "kalender"]},
    {"id": "map", "label": "Campus map, rooms, buildings", "kind": "request",
     "patterns": ["\\bmap\\b", "карт[аеуы]", "аудитори", "корпус", "lageplan", "raum", "building", "room number"]},
    {"id": "privacy", "label": "Privacy and personal data", "kind": "complaint",
     "patterns": ["privacy", "personal (data|information)", "персональн", "datenschutz", "my data", "selling (my|your) data"]}
  ]
}
